# Supabase project (frontend, safe to expose — RLS enforces access control)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — set as Supabase Edge Function secrets, never in the frontend.
# Used by supabase/functions/lemlist-sync to write with elevated privileges and
# decrypt each client's stored Lemlist API key.
# SUPABASE_SERVICE_ROLE_KEY=
# LEMLIST_KEY_ENCRYPTION_SECRET=
